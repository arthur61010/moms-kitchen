# 擇一填寫（OpenAI 優先）。都不填 = 示範模式（假資料）
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# GEMINI_THINKING=low
# 公開網址時建議設定，避免陌生人用掉額度
APP_PASSCODE=
# 花費上限（依 Gemini 回傳的實際 token 數 × 官方價目計算，台北時間每月 1 號歸零）
# MONTHLY_BUDGET_TWD=50
# USD_TWD=33
# 每台裝置（或 IP）每天可用次數（一次＝辨識＋出食譜）
# DAILY_LIMIT_PER_USER=10
# 用量紀錄檔（Render 免費方案磁碟會在休眠/重新部署時清空）
# USAGE_FILE=./data/usage.json
# 選填：Redis/Render Key Value 連線字串，優先於檔案
# REDIS_URL=
PORT=8787
